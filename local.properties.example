## Copy this file to local.properties and fill in your values
## local.properties is git-ignored and machine-specific

# SDK location (Auto-generated by Android Studio)
sdk.dir=/path/to/your/Android/sdk

# Supabase Configuration
# For local development, use your computer's local IP address
# Find it with: ifconfig | grep "inet " | grep -v 127.0.0.1

# For testing on emulator:
# SUPABASE_URL=http://10.0.2.2:54321

# For testing on physical device (replace with your local IP):
SUPABASE_URL=http://YOUR.LOCAL.IP.ADDRESS:54321

# Local Supabase anon key (from supabase status or your backend .env)
SUPABASE_ANON_KEY=your-local-supabase-anon-key

# Production Supabase (when you deploy)
# SUPABASE_URL_PRODUCTION=https://your-project.supabase.co
# SUPABASE_ANON_KEY_PRODUCTION=your-production-key

# Staging Supabase (if you have one)
# SUPABASE_URL_STAGING=https://your-staging-project.supabase.co
# SUPABASE_ANON_KEY_STAGING=your-staging-key
